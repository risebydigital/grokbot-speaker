[Unit]
Description=Grok Voice Assistant local API
After=network-online.target

[Service]
Type=simple
User=gva
Group=gva
WorkingDirectory=/opt/gva/app
Environment=GVA_CONFIG=/etc/gva/config.yaml
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/gva/gva.env
ExecStart=/opt/gva/venv/bin/uvicorn gva.backend.app:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=120
StartLimitBurst=5
MemoryMax=512M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gva /var/log/gva /etc/gva
PrivateTmp=true

[Install]
WantedBy=multi-user.target
