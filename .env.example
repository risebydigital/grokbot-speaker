# Developer convenience copy of the variable names. The device file is /etc/gva/gva.env.
# See gva.env.example for what each secret is for. Do not put real values here.

XAI_API_KEY=<YOUR_XAI_API_KEY>
GVA_HASH_PEPPER=<64_HEX_CHARS_FROM_openssl_rand_-hex_32>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
GVA_API_TOKEN_SECRET=<RANDOM_SECRET_FOR_JWT_SIGNING>
GVA_ALERT_SLACK_WEBHOOK=
GVA_HEARTBEAT_URL=
