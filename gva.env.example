# Copy to /etc/gva/gva.env on the device.
#   sudo install -m 600 -o gva -g gva gva.env.example /etc/gva/gva.env
# Then edit it as root. Never commit the filled-in file.
#
# The device writes telemetry with the Supabase *service role* key (SUPABASE_SERVICE_KEY).
# That key bypasses row-level security. It must live only in this file on the Pi.
# Do not put it in Lovable, the dashboard, a browser bundle, Git, or a screenshot.
# The dashboard uses the anon (public) key, which is safe only because RLS is on.

XAI_API_KEY=<YOUR_XAI_API_KEY>
GVA_HASH_PEPPER=<64_HEX_CHARS_FROM_openssl_rand_-hex_32>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
GVA_API_TOKEN_SECRET=<RANDOM_SECRET_FOR_JWT_SIGNING>
GVA_ALERT_SLACK_WEBHOOK=<SLACK_WEBHOOK_URL_OR_EMPTY>
GVA_HEARTBEAT_URL=<HEALTHCHECK_PING_URL_OR_EMPTY>

# Bot bridge. Leave both blank to keep it off.
# Copy the header name and prefix into config.yaml (bot_bridge.key_header, bot_bridge.key_prefix).
GVA_GROKBOT_WEBHOOK_URL=
GVA_GROKBOT_WEBHOOK_KEY=
