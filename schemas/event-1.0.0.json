{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gva.local/event/1.0.0",
  "title": "GVA telemetry event",
  "type": "object",
  "required": ["schema_version", "event_id", "type", "ts", "mono_ms", "device_id", "app_version", "env", "source", "level"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "event_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "type": {"type": "string", "enum": [
      "app.started", "app.stopped", "heartbeat", "state.changed", "wake.detected",
      "stt.completed", "llm.started", "llm.completed", "tool.started", "tool.completed",
      "tool.rejected", "tts.completed", "playback.completed", "playback.underrun", "turn.completed", "error",
      "config.changed", "budget.threshold", "budget.degraded", "eval.case", "eval.summary",
      "sync.completed", "audio.device_lost",
      "bridge.sent", "bridge.answered", "bridge.timeout", "bridge.error",
      "bridge.queued", "bridge.spoken", "bridge.delivery_failed", "bridge.timeout_spoken",
      "bridge.late_delivered", "bridge.deferred", "bridge.nudged",
      "heads_up.scheduled", "heads_up.spoken"
    ]},
    "ts": {"type": "string", "format": "date-time"},
    "mono_ms": {"type": "integer", "minimum": 0},
    "device_id": {"type": "string", "pattern": "^[a-z0-9-]{2,40}$"},
    "app_version": {"type": "string"},
    "env": {"type": "string", "enum": ["dev", "staging", "prod"]},
    "session_id": {"type": ["string", "null"]},
    "turn_id": {"type": ["string", "null"]},
    "request_id": {"type": ["string", "null"]},
    "source": {"type": "string", "enum": ["runtime", "cli", "eval", "backend"]},
    "level": {"type": "string", "enum": ["debug", "info", "warning", "error", "critical"]}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "llm.completed"}}, "required": ["type"]},
     "then": {"$ref": "#/$defs/llm_completed"}},
    {"if": {"properties": {"type": {"const": "turn.completed"}}, "required": ["type"]},
     "then": {"$ref": "#/$defs/turn_completed"}},
    {"if": {"properties": {"type": {"const": "error"}}, "required": ["type"]},
     "then": {"$ref": "#/$defs/error"}},
    {"if": {"properties": {"type": {"const": "heartbeat"}}, "required": ["type"]},
     "then": {"$ref": "#/$defs/heartbeat"}},
    {"if": {"properties": {"type": {"const": "tool.completed"}}, "required": ["type"]},
     "then": {"$ref": "#/$defs/tool_completed"}},
    {"if": {"properties": {"type": {"const": "stt.completed"}}, "required": ["type"]},
     "then": {"$ref": "#/$defs/stt_completed"}},
    {"if": {"properties": {"type": {"const": "bridge.answered"}}, "required": ["type"]},
     "then": {"required": ["latency_ms"], "properties": {"latency_ms": {"type": "integer", "minimum": 0}}}},
    {"if": {"properties": {"type": {"const": "bridge.queued"}}, "required": ["type"]},
     "then": {"required": ["wait_ms"], "properties": {"wait_ms": {"type": "integer", "minimum": 0}}}},
    {"if": {"properties": {"type": {"const": "bridge.spoken"}}, "required": ["type"]},
     "then": {"properties": {"wait_ms": {"type": "integer", "minimum": 0}}}},
    {"if": {"properties": {"type": {"const": "bridge.delivery_failed"}}, "required": ["type"]},
     "then": {"required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 80}}}}
  ],
  "$defs": {
    "usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "cost_in_usd_ticks": {"type": ["integer", "null"], "minimum": 0}
      },
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"]
    },
    "redacted_text": {"type": ["string", "null"], "maxLength": 2000},
    "hash": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"},
    "llm_completed": {
      "required": ["model", "round", "status", "duration_ms"],
      "properties": {
        "model": {"type": "string"},
        "round": {"type": "integer", "minimum": 1},
        "stream": {"type": "boolean"},
        "status": {"type": "string", "enum": ["ok", "error", "cancelled"]},
        "http_status": {"type": ["integer", "null"]},
        "xai_response_id": {"type": ["string", "null"]},
        "system_fingerprint": {"type": ["string", "null"]},
        "finish_reason": {"type": ["string", "null"]},
        "ttft_ms": {"type": ["integer", "null"], "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "retry_count": {"type": "integer", "minimum": 0},
        "tool_calls_requested": {"type": "array", "items": {"type": "string"}},
        "usage": {"$ref": "#/$defs/usage"},
        "usage_missing": {"type": "boolean"},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "cost_estimated": {"type": "boolean"}
      }
    },
    "turn_completed": {
      "required": ["status", "stage_timings", "total_ms", "fallback_spoken"],
      "properties": {
        "status": {"type": "string", "enum": ["ok", "degraded", "error", "cancelled"]},
        "intent": {"type": ["string", "null"]},
        "prompt_redacted": {"$ref": "#/$defs/redacted_text"},
        "prompt_hash": {"$ref": "#/$defs/hash"},
        "prompt_chars": {"type": "integer", "minimum": 0},
        "response_redacted": {"$ref": "#/$defs/redacted_text"},
        "response_hash": {"$ref": "#/$defs/hash"},
        "sensitive": {"type": "boolean"},
        "sensitive_category": {"type": ["string", "null"]},
        "hash_epoch": {"type": "integer", "minimum": 1},
        "tools_called": {"type": "array", "items": {"type": "string"}},
        "rounds": {"type": "integer", "minimum": 0},
        "stage_timings": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "e2e_first_audio_ms": {"type": ["integer", "null"], "minimum": 0},
        "total_ms": {"type": "integer", "minimum": 0},
        "tokens_total": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "fallback_spoken": {"type": "boolean"}
      }
    },
    "error": {
      "required": ["category", "error_code", "message", "retryable"],
      "properties": {
        "category": {"type": "string", "enum": ["audio", "stt", "llm_rate_limit", "llm_server", "llm_client", "tool", "tts", "network", "internal"]},
        "error_code": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"},
        "message": {"type": "string", "maxLength": 300},
        "stage": {"type": ["string", "null"]},
        "retryable": {"type": "boolean"},
        "retry_count": {"type": "integer", "minimum": 0},
        "fallback_spoken": {"type": "boolean"}
      }
    },
    "heartbeat": {
      "required": ["cpu_pct", "mem_pct", "disk_pct"],
      "properties": {
        "cpu_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "mem_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "disk_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "temp_c": {"type": ["number", "null"]},
        "throttled": {"type": "boolean"},
        "queue_depths": {"type": "object", "additionalProperties": {"type": "integer"}},
        "api_reachable": {"type": ["boolean", "null"]}
      }
    },
    "tool_completed": {
      "required": ["tool_name", "status", "duration_ms"],
      "properties": {
        "tool_name": {"type": "string"},
        "tool_call_id": {"type": ["string", "null"]},
        "args_redacted": {"type": "object"},
        "status": {"type": "string", "enum": ["ok", "error", "timeout", "rejected"]},
        "error_code": {"type": ["string", "null"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "result_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "stt_completed": {
      "required": ["engine", "audio_ms", "duration_ms"],
      "properties": {
        "engine": {"type": "string", "enum": ["faster_whisper", "vosk", "xai"]},
        "model": {"type": "string"},
        "audio_ms": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "language": {"type": ["string", "null"]},
        "prompt_redacted": {"$ref": "#/$defs/redacted_text"},
        "prompt_hash": {"$ref": "#/$defs/hash"},
        "rejected_reason": {"type": ["string", "null"]}
      }
    }
  }
}
